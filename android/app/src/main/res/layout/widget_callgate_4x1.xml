<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="7dp">

    <LinearLayout
        android:id="@+id/widget_status_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="3dp">

        <TextView
            android:id="@+id/widget_status_dot"
            android:layout_width="12dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="●"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_brand"
                android:textColor="@color/widget_text_active"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_status_normal"
                android:textColor="@color/widget_text_active"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_driving"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_idle"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/widget_icon_driving"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_action_driving"
            android:src="@drawable/ic_widget_drive" />

        <TextView
            android:id="@+id/widget_label_driving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_action_driving"
            android:textColor="@color/widget_text_idle"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_whitelist"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_idle"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/widget_icon_whitelist"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_action_whitelist"
            android:src="@drawable/ic_widget_whitelist" />

        <TextView
            android:id="@+id/widget_label_whitelist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_action_whitelist"
            android:textColor="@color/widget_text_idle"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_schedule"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_idle"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/widget_icon_schedule"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_action_schedule"
            android:src="@drawable/ic_widget_schedule" />

        <TextView
            android:id="@+id/widget_label_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_action_schedule"
            android:textColor="@color/widget_text_idle"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
